generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id             String          @id @default(uuid(7))
  specifications Specification[]
  name           String
  addressId      String
  address        Address         @relation(fields: [addressId], references: [id])
  storeContacts  StoreContact[]
  users          StoreUser[]
  slug           String          @unique
  categories     Category[]
  roles          Role[]
  items          Item[]
  deletedAt      DateTime?
  updatedAt      DateTime?       @updatedAt
}

model Category {
  id          String     @id @default(uuid(7))
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  name        String
  description String?
  deletedAt   DateTime?
  updatedAt   DateTime?  @updatedAt
  items       Item[]

  @@unique([storeId, parentId, name])
}

model Item {
  id          String  @id @default(uuid(7))
  name        String
  number      String
  description String?
  price       Float

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  vendors Vendor[]

  itemSpecificationValues ItemSpecificationValue[]

  deletedAt DateTime?
  updatedAt DateTime? @updatedAt

  @@unique([storeId, number])
}

model Vendor {
  id             String          @id @default(uuid(7))
  name           String
  description    String?
  vendorContacts VendorContact[]
  vendorItems    Item[]
  addressId      String
  address        Address         @relation(fields: [addressId], references: [id])
  deletedAt      DateTime?
  updatedAt      DateTime?       @updatedAt
}

model Client {
  id             String          @id @default(uuid(7))
  name           String
  description    String?
  clientContacts ClientContact[]
  addressId      String
  address        Address         @relation(fields: [addressId], references: [id])
  deletedAt      DateTime?
  updatedAt      DateTime?       @updatedAt
}

model ClientContact {
  id        String  @id @default(uuid(7))
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
}

model VendorContact {
  id        String  @id @default(uuid(7))
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
}

model Contact {
  id             String          @id @default(uuid(7))
  name           String
  email          String
  phone          String
  storeContacts  StoreContact[]
  vendorContacts VendorContact[]
  clientContacts ClientContact[]
  deletedAt      DateTime?
  updatedAt      DateTime?       @updatedAt
}

model StoreContact {
  id        String  @id @default(uuid(7))
  storeId   String
  contactId String
  store     Store   @relation(fields: [storeId], references: [id])
  contact   Contact @relation(fields: [contactId], references: [id])
}

model Address {
  id        String    @id @default(uuid(7))
  street    String
  city      String
  state     String
  zipCode   String
  stores    Store[]
  vendors   Vendor[]
  clients   Client[]
  updatedAt DateTime? @updatedAt
}

model StoreUser {
  id        String    @id @default(uuid(7))
  name      String
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  username  String
  password  String
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  deletedAt DateTime?
  updatedAt DateTime? @updatedAt

  @@unique([storeId, username])
}

model Permission {
  id              String           @id @default(uuid(7))
  key             String           @unique
  rolePermissions RolePermission[]
}

model Role {
  id              String           @id @default(uuid(7))
  name            String
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  rolePermissions RolePermission[]
  admins          StoreUser[]
  grantsAll       Boolean
  deletedAt       DateTime?
  updatedAt       DateTime?        @updatedAt

  @@unique([storeId, name])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

enum SpecificationValueType {
  STRING
  BOOLEAN
  NUMBER
}

model Specification {
  id         String  @id
  name       String
  categoryId String?
  storeId    String

  type                    SpecificationValueType
  isPrimary               Boolean
  isRequired              Boolean
  specificationValues     SpecificationValue[]
  itemSpecificationValues ItemSpecificationValue[]
  isActive                Boolean                  @default(true)
  deletedAt               DateTime?
  updatedAt               DateTime?                @updatedAt
  stores                  Store[]

  @@unique([categoryId, name, storeId])
}

model SpecificationValue {
  id              String        @id
  value           String
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?

  itemSpecificationValues ItemSpecificationValue[]
}

model ItemSpecificationValue {
  id                   String @id
  itemId               String
  specificationId      String
  specificationValueId String

  item               Item               @relation(fields: [itemId], references: [id])
  specification      Specification      @relation(fields: [specificationId], references: [id])
  specificationValue SpecificationValue @relation(fields: [specificationValueId], references: [id])
}
