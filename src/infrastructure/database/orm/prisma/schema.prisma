generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum SpecificationValueType {
  STRING
  BOOLEAN
  NUMBER
  OPTION
}

model Store {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  addressId String    @db.Uuid
  address   Address   @relation(fields: [addressId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts       Contact[]
  users          StoreUser[]
  roles          Role[]
  categories     Category[]
  items          Item[]
  vendors        Vendor[]
  clients        Client[]
  specifications Specification[]
}

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  storeId     String     @db.Uuid
  store       Store      @relation(fields: [storeId], references: [id])
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  items          Item[]
  specifications Specification[]

  @@unique([storeId, parentId, name]) // + partial unique index (parentId IS NULL) via raw SQL
  @@index([storeId, parentId])
}

model Item {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     String    @db.Uuid
  store       Store     @relation(fields: [storeId], references: [id])
  categoryId  String?   @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id])
  number      String
  sku         String?
  barcode     String?
  name        String
  description String?
  unit        String    @default("pcs")
  price       Decimal   @db.Decimal(14, 2)
  cost        Decimal?  @db.Decimal(14, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  vendors    ItemVendor[]
  specValues ItemSpecificationValue[]

  @@unique([storeId, number])
  @@unique([storeId, sku])
  @@index([storeId, categoryId])
  @@index([storeId, deletedAt])
}

model ItemVendor {
  itemId       String   @db.Uuid
  vendorId     String   @db.Uuid
  vendorSku    String?
  costPrice    Decimal? @db.Decimal(14, 2)
  leadTimeDays Int?
  isPreferred  Boolean  @default(false)
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([itemId, vendorId])
  @@index([vendorId])
}

model Vendor {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     String    @db.Uuid
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  description String?
  addressId   String?   @db.Uuid
  address     Address?  @relation(fields: [addressId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  contacts VendorContact[]
  items    ItemVendor[]

  @@index([storeId, deletedAt])
}

model Client {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     String    @db.Uuid
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  description String?
  addressId   String?   @db.Uuid
  address     Address?  @relation(fields: [addressId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  contacts ClientContact[]

  @@index([storeId, deletedAt])
}

model Contact {
  id        String    @id @default(uuid(7)) @db.Uuid
  storeId   String    @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vendorContacts VendorContact[]
  clientContacts ClientContact[]

  @@index([storeId])
}

model VendorContact {
  vendorId  String  @db.Uuid
  contactId String  @db.Uuid
  isPrimary Boolean @default(false)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([vendorId, contactId])
  @@index([contactId])
}

model ClientContact {
  clientId  String  @db.Uuid
  contactId String  @db.Uuid
  isPrimary Boolean @default(false)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([clientId, contactId])
  @@index([contactId])
}

model Address {
  id        String   @id @default(uuid(7)) @db.Uuid
  line1     String
  line2     String?
  city      String
  state     String
  zipCode   String
  country   String   @default("IR") @db.Char(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores  Store[]
  vendors Vendor[]
  clients Client[]
}

model StoreUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      String    @db.Uuid
  store        Store     @relation(fields: [storeId], references: [id])
  roleId       String    @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id])
  name         String
  username     String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([storeId, username])
  @@index([roleId])
}

model Permission {
  id    String           @id @default(uuid(7)) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model Role {
  id        String    @id @default(uuid(7)) @db.Uuid
  storeId   String    @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  grantsAll Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  users       StoreUser[]

  @@unique([storeId, name])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Specification {
  id         String                 @id @default(uuid(7)) @db.Uuid
  storeId    String                 @db.Uuid
  store      Store                  @relation(fields: [storeId], references: [id])
  categoryId String?                @db.Uuid
  category   Category?              @relation(fields: [categoryId], references: [id])
  name       String
  type       SpecificationValueType
  isPrimary  Boolean                @default(false)
  isRequired Boolean                @default(false)
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  deletedAt  DateTime?

  options SpecificationValue[]
  values  ItemSpecificationValue[]

  @@unique([storeId, categoryId, name]) // + partial unique (categoryId IS NULL) via raw SQL
  @@index([categoryId])
}

// گزینه‌های از پیش تعریف‌شده (فقط برای type = OPTION)
model SpecificationValue {
  id              String        @id @default(uuid(7)) @db.Uuid
  specificationId String        @db.Uuid
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  value           String
  sortOrder       Int           @default(0)
  deletedAt       DateTime?

  itemValues ItemSpecificationValue[]

  @@unique([specificationId, value])
}

model ItemSpecificationValue {
  itemId          String   @db.Uuid
  specificationId String   @db.Uuid
  optionId        String?  @db.Uuid
  valueString     String?
  valueNumber     Decimal? @db.Decimal(18, 4)
  valueBoolean    Boolean?

  item          Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  specification Specification       @relation(fields: [specificationId], references: [id])
  option        SpecificationValue? @relation(fields: [optionId], references: [id])

  @@id([itemId, specificationId])
  @@index([specificationId, valueNumber])
  @@index([optionId])
}
